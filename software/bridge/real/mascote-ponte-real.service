[Unit]
Description=Ponte REAL do mascote (v1) - systemd --user
Wants=mascote-tmux.service
After=network-online.target mascote-tmux.service

[Service]
Type=simple
# PORTA vem de ~/.config/mascote/unit.env (8791 em teste; 8787 depois de trocar_producao.sh)
Environment=PORTA=8791
EnvironmentFile=-%h/.config/mascote/unit.env
# token do aparelho: ~/.config/mascote/ponte.env (PONTE_TOKEN=..., 0600), lido pelo proprio programa
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
ExecStart=/usr/bin/python3 %h/testes/software/bridge/real/ponte_real.py --porta ${PORTA}
Restart=on-failure
RestartSec=3
# Sessoes claude vivem no servidor `tmux -L mascote` de mascote-tmux.service (outro cgroup).
# KillMode=process mantido por seguranca caso o servidor nasca aqui.
KillMode=process

[Install]
WantedBy=default.target
